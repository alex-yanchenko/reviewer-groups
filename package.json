{
  "name": "reviewer-groups",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension: request GitHub pull request reviews from several people at once, and save them as groups.",
  "license": "MIT",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "package": "node build.mjs --zip",
    "screenshots": "node screenshots/capture.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "p-wait-for": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
